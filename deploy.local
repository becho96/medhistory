#!/bin/bash

# ==================================================
# MedHistory Deploy Script
# ==================================================
# Скрипт для локального развертывания
#
# Использование:
#   ./deploy                    # Запуск
#   ./deploy --rebuild          # Пересобрать образы
#   ./deploy --monitoring       # С мониторингом
#   ./deploy --clean-data       # Удалить все данные БД
#   ./deploy --update           # Быстрое обновление
# ==================================================

set -e

# Опции
REBUILD=false
WITH_MONITORING=false
CLEAN_DATA=false
UPDATE_ONLY=false

# Парсинг аргументов
while [[ $# -gt 0 ]]; do
    case $1 in
        --rebuild)
            REBUILD=true
            shift
            ;;
        --monitoring)
            WITH_MONITORING=true
            shift
            ;;
        --clean-data)
            CLEAN_DATA=true
            shift
            ;;
        --update)
            UPDATE_ONLY=true
            shift
            ;;
        *)
            echo "❌ Неизвестная опция: $1"
            echo ""
            echo "Использование: ./deploy [опции]"
            echo ""
            echo "Опции:"
            echo "  --rebuild       Пересобрать образы"
            echo "  --monitoring    Включить мониторинг"
            echo "  --update        Быстрое обновление (без пересборки)"
            echo "  --clean-data    ⚠️  УДАЛИТЬ ВСЕ ДАННЫЕ БД"
            exit 1
            ;;
    esac
done

# Пути
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
ENV_FILE="${PROJECT_ROOT}/.env.local"
        PROJECT_NAME="medhistory"

# Цвета
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

print_success() { echo -e "${GREEN}✅ $1${NC}"; }
print_error() { echo -e "${RED}❌ $1${NC}"; }
print_warning() { echo -e "${YELLOW}⚠️  $1${NC}"; }
print_info() { echo -e "${BLUE}ℹ️  $1${NC}"; }
print_header() {
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}$1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# Вывод информации
print_header "🚀 MedHistory Deploy"

# Проверка конфигурации
echo "🔍 Проверка конфигурации..."
if [ ! -f "$ENV_FILE" ]; then
    print_error "Файл конфигурации не найден: $ENV_FILE"
    print_info "Создайте файл .env.local с необходимыми переменными"
    exit 1
fi

# Загрузка переменных окружения
set -a
source "$ENV_FILE"
set +a
print_success "Загружена конфигурация"
    
    cd "$PROJECT_ROOT"
    
    # Остановка старых контейнеров
    if [ "$CLEAN_DATA" = true ]; then
        print_warning "⚠️  ВНИМАНИЕ: Будут удалены ВСЕ ДАННЫЕ БД!"
        read -p "Вы уверены? Введите 'YES' для подтверждения: " confirmation
        if [ "$confirmation" != "YES" ]; then
            print_error "Отменено пользователем"
            exit 1
        fi
        print_info "🗑️  Остановка контейнеров и удаление данных..."
    docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" down -v
    else
        print_info "🛑 Остановка старых контейнеров (данные БД сохраняются)..."
    docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" down || true
    fi
    
    # Пересборка если нужно
    if [ "$UPDATE_ONLY" = false ]; then
        if [ "$REBUILD" = true ]; then
            print_info "🔨 Пересборка образов..."
        docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" build --no-cache
        else
            print_info "🔨 Сборка образов..."
        docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" build
        fi
    else
        print_info "⚡ Быстрое обновление (без пересборки образов)..."
    fi
    
    # Запуск контейнеров
    print_info "🚀 Запуск контейнеров..."
docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" up -d
    
    # Запуск мониторинга если нужно
    if [ "$WITH_MONITORING" = true ]; then
        print_info "📊 Запуск мониторинга..."
    docker compose -p $PROJECT_NAME -f docker-compose.monitoring.yml --env-file "$ENV_FILE" up -d
    fi
    
    # Ожидание готовности
    print_info "⏳ Ожидание готовности сервисов..."
    sleep 10
    
    # Проверка статуса
    print_info "📊 Статус сервисов:"
docker compose -p $PROJECT_NAME --env-file "$ENV_FILE" ps
    
    # Вывод информации
    print_header "✅ Развертывание завершено!"
    echo ""
    print_success "🌐 Доступные сервисы:"
            echo "   • Frontend:         http://localhost:5173"
            echo "   • Backend API:      http://localhost:8000"
            echo "   • API Docs:         http://localhost:8000/docs"
            echo "   • MinIO Console:    http://localhost:9001"
            echo "   • DB Viewer:        http://localhost:5050 (включая Маппинг анализов в sidebar)"
            if [ "$WITH_MONITORING" = true ]; then
                echo "   • Grafana:          http://localhost:3000"
                echo "   • Prometheus:       http://localhost:9090"
            fi
    
    echo ""
    print_info "📝 Полезные команды:"
echo "   • Просмотр логов:    docker compose -p $PROJECT_NAME logs -f"
echo "   • Остановка:         docker compose -p $PROJECT_NAME stop"
echo "   • Перезапуск:        ./deploy"
    echo ""

print_success "🎉 Готово!"
